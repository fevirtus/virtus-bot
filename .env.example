# Discord Developer Portal -> Bot -> Token (never commit the real token)
BOT_TOKEN=
# PostgreSQL connection used by this application; preserve your existing DB.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=virtus
# Alternative: POSTGRES_URL=postgresql://user:password@host:5432/database
POSTGRES_ECHO=false
